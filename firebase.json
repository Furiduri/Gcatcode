{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/cv/projects/?$",
        "destination": "/projects/",
        "type": 301
      },
      {
        "regex": "^/en/cv/projects/?$",
        "destination": "/en/projects/",
        "type": 301
      },
      {
        "regex": "^/es/?$",
        "destination": "/cv/",
        "type": 301
      },
      {
        "regex": "^/es/projects/?$",
        "destination": "/projects/",
        "type": 301
      }
    ]
  }
}
